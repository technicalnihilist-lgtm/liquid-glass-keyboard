<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.liquidglass.keyboard.GlassBackdrop
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingTop="52dp"
            android:paddingRight="22dp"
            android:paddingBottom="34dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.01"
                android:text="Liquid Glass"
                android:textSize="31sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.72"
                android:text="Generation 3 — tune the glass yourself"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.9"
                android:text="Checking status…"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/cardSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_glass"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="SETUP" />

                <Button
                    android:id="@+id/btnEnable"
                    style="@style/GlassButton"
                    android:text="1 · Enable keyboard" />

                <Button
                    android:id="@+id/btnSelect"
                    style="@style/GlassButton"
                    android:text="2 · Choose keyboard" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:alpha="0.6"
                    android:text="After enabling, switch to it from any text field with the keyboard button in the navigation bar."
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_glass"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="TRY IT" />

                <EditText
                    android:id="@+id/tryField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edit_glass"
                    android:gravity="top|start"
                    android:hint="Tap here and start typing…"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minHeight="88dp"
                    android:padding="14dp"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardGlass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_glass"
                android:orientation="vertical"
                android:padding="18dp" />

            <LinearLayout
                android:id="@+id/cardKeys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_glass"
                android:orientation="vertical"
                android:padding="18dp" />

            <LinearLayout
                android:id="@+id/cardAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_glass"
                android:orientation="vertical"
                android:padding="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:alpha="0.55"
                android:gravity="center"
                android:text="No internet permission · 100% on-device · v3.0"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
